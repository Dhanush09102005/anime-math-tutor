# Copy this to .env and fill in real values. Never commit the real .env.

# Postgres
POSTGRES_PASSWORD=changeme
# Local dev without Docker (Postgres running on your machine directly):
DATABASE_URL=postgresql+psycopg2://tutor:changeme@localhost:5432/tutor

# Auth
JWT_SECRET_KEY=generate-with-python-secrets-token_hex-32
SESSION_SECRET_KEY=generate-a-different-random-secret-than-JWT_SECRET_KEY

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# LLM (unchanged from v1.4.0+)
HF_TOKEN = your_hf_key       #not used anymore
GROQ_API_KEY=your_groq_key

# Frontend origin — where OAuth redirects back to after login
FRONTEND_URL=http://localhost:5173

# development | production — flips the auth cookie's `secure` flag (must be
# production/https for cookies to actually be sent in real deployment)
ENV=development
