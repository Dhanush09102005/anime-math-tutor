# Copy this to .env and fill in real values. Never commit the real .env.

# Postgres
POSTGRES_PASSWORD=changeme
# Host port for connecting to the Compose database (container port stays 5432).
POSTGRES_HOST_PORT=5433
# Local dev without Docker (Postgres running on your machine directly):
DATABASE_URL=postgresql+psycopg2://tutor:changeme@localhost:5432/tutor

# Auth
JWT_SECRET_KEY=generate-with-python-secrets-token_hex-32
SESSION_SECRET_KEY=generate-a-different-random-secret-than-JWT_SECRET_KEY
# Comma-separated email addresses allowed to create question papers and view student progress.
ADMIN_EMAILS=admin@example.com

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# LLM
GROQ_API_KEY=your_groq_key

# Frontend origin — where OAuth redirects back after login.
# Docker Compose serves the frontend at port 80; local Vite dev is port 5173.
FRONTEND_URL=http://localhost

# development | production — flips the auth cookie's `secure` flag (must be
# production/https for cookies to actually be sent in real deployment)
ENV=development

# Frontend build (Docker only). Nginx proxies /api to the backend container.
VITE_API_URL=/api
